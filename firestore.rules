rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isInspector() {
      return isSignedIn() && (
        getUserData().role == 'inspector' ||
        isAdmin()
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection: Private read/update by owner or admin
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isAdmin();
    }

    // Wheelchair Tokens: Read by owner, facility verifier, or admin
    match /wheelchairTokens/{tokenId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Access Logs: Verifiers/users can create logs, read by owner or admin
    match /accessLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Locations: Public read, write by inspector or admin
    match /locations/{locationId} {
      allow read: if true;
      allow create, update: if isInspector();
      allow delete: if isAdmin();
    }

    // Accessibility Reports: Public read, created by inspector
    match /accessibilityReports/{reportId} {
      allow read: if true;
      allow create: if isInspector();
      allow update: if isInspector();
      allow delete: if isAdmin();
    }

    // Detections: Public read, created by inspector
    match /detections/{detectionId} {
      allow read: if true;
      allow create: if isInspector();
      allow delete: if isAdmin();
    }
  }
}
